{
    "name": "vuthaihoc/laravel-tts-client",
    "description": "Laravel client for the Piper TTS API (laravel-tts-api): signs temporary tokens locally, synthesizes and streams speech.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "tts", "text-to-speech", "piper"],
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^6.10|^7.0",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Vuthaihoc\\TtsClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vuthaihoc\\TtsClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vuthaihoc\\TtsClient\\TtsServiceProvider"
            ],
            "aliases": {
                "Tts": "Vuthaihoc\\TtsClient\\Facades\\Tts"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
